<Window x:Class="WpfApp1.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="Window1" Height="450" Width="800">
    <WrapPanel Orientation="Vertical">
        <WrapPanel>
            <Label>标签</Label>
            <Label>
                <CheckBox>爱好</CheckBox>
            </Label>

            <Label Target="{Binding ElementName=Name}">_Name</Label>
            <TextBox Name="Name" Width="100" Height="30"></TextBox>
            <Label Target="{Binding ElementName=age}">_AgN</Label>
            <TextBox Name="age" Width="100" Height="30"></TextBox>
        </WrapPanel>
        <WrapPanel Margin="0 20">
            <TextBox x:Name="input" Width="120"></TextBox>
            <Label Content="{Binding Text,ElementName=input}" x:Name="myLabel"></Label>
            <Label Content="{Binding Text.Length,ElementName=input}"></Label>
        </WrapPanel>
        <WrapPanel Margin="0 20">
            <Button Click="GetWidth" Width="{Binding ActualWidth,ElementName=myLabel}">获取label的实际宽度</Button>
        </WrapPanel>
    </WrapPanel>
</Window>
